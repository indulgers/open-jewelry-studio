  "components": [
    {
      "name": "相言 · 主要按钮",
      "kind": "button",
      "refersTo": "shop-button-primary",
      "description": "定制与确认动作，使用当前主题的墨色与页面浅色。",
      "html": "<button class=\"ds-shop-button\">开始专属定制</button>",
      "css": ".ds-shop-button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;gap:10px;padding:13px 24px;border:1px solid var(--ink,#16130c);border-radius:var(--button-radius,99px);background:var(--ink,#16130c);color:var(--page,#faf8f3);font:600 14px/1.3 -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;text-decoration:none;cursor:pointer;transition:background-color .18s ease-out}.ds-shop-button:hover{background:var(--shop-dark-2,#211b10);border-color:var(--shop-dark-2,#211b10);color:var(--on-dark,#f4eedf)}.ds-shop-button:focus-visible{outline:2px solid var(--accent,#8c6d1f);outline-offset:5px}.ds-shop-button:disabled{opacity:.5;cursor:not-allowed}@media(max-width:760px){.ds-shop-button{min-height:48px;padding-inline:20px;font-size:13px}}"
    },
    {
      "name": "相言 · 描边按钮",
      "kind": "button",
      "refersTo": "shop-button-outline",
      "description": "原款选购等并列次要动作。",
      "html": "<button class=\"ds-shop-button ds-shop-outline\">选购原款</button>",
      "css": ".ds-shop-button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;gap:10px;padding:13px 24px;border:1px solid var(--ink,#16130c);border-radius:var(--button-radius,99px);background:var(--ink,#16130c);color:var(--page,#faf8f3);font:600 14px/1.3 -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;text-decoration:none;cursor:pointer;transition:background-color .18s ease-out}.ds-shop-button:hover{background:var(--shop-dark-2,#211b10);border-color:var(--shop-dark-2,#211b10);color:var(--on-dark,#f4eedf)}.ds-shop-button:focus-visible{outline:2px solid var(--accent,#8c6d1f);outline-offset:5px}.ds-shop-button:disabled{opacity:.5;cursor:not-allowed}@media(max-width:760px){.ds-shop-button{min-height:48px;padding-inline:20px;font-size:13px}}.ds-shop-outline{background:transparent;color:var(--ink,#16130c)}.ds-shop-outline:hover{background:var(--tint,#f1ebdd);color:var(--ink,#16130c);border-color:var(--ink,#16130c)}"
