{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:public",
  "outputDirectory": "dist",
  "functions": {
    "api/jewelry-admin.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/model-admin",
      "destination": "/api/jewelry-admin?path=models"
    },
    {
      "source": "/api/model-admin/:path*",
      "destination": "/api/jewelry-admin?path=:path*"
    },
    {
      "source": "/models/:path*",
      "destination": "/api/jewelry-admin?path=assets/models/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/jewelry-admin?path=assets/media/:path*"
    }
  ],
  "headers": []
}
