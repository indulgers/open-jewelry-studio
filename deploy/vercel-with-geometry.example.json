{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/forme/:path*",
      "destination": "https://YOUR-GEOMETRY-HOST/api/forme/:path*"
    }
  ]
}
